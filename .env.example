# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# These are secrets / per-user credentials; config.yaml holds non-secret settings.

# --- AWS credentials (control node → AWS) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-2

# --- VMware / ESXi (control node -> source, used by discovery) ---------------
# NOTE: docker --env-file does NOT strip trailing "# comments" from a value.
# Keep every value on its own line with nothing after it.
GOVC_URL=https://sd-wro-esxi-rhos-1.intive.org
GOVC_USERNAME=
GOVC_PASSWORD=
# GOVC_INSECURE: 1 for self-signed/expired lab certs, 0 in production.
GOVC_INSECURE=1

# --- Database Migration Service source credentials ---------------------------
DMS_SOURCE_USERNAME=
DMS_SOURCE_PASSWORD=

# --- SSH key for Ansible to reach migrated EC2 instances ---------------------
SSH_PRIVATE_KEY_PATH=~/.ssh/vmware2aws_demo
